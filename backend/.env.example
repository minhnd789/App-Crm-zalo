# Cổng chạy API
PORT=4000

# Database: SQLite cho dev. Production nên dùng PostgreSQL/MySQL
# (đổi provider trong prisma/schema.prisma rồi đặt DATABASE_URL tương ứng)
DATABASE_URL="file:./dev.db"

# Khoá ký JWT – BẮT BUỘC đổi khi chạy thật
JWT_SECRET_APP="change-me-app-secret"
JWT_SECRET_ADMIN="change-me-admin-secret"

# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). Để trống = cho phép tất cả
CORS_ORIGINS=""

# Zalo Mini App: lấy tại https://mini.zalo.me (Cài đặt ứng dụng)
ZALO_APP_ID=""
ZALO_APP_SECRET_KEY=""

# Zalo OA: access token để gửi tin nhắn thông báo cho khách (tuỳ chọn)
ZALO_OA_ACCESS_TOKEN=""

# true = bỏ qua xác thực với Zalo (chỉ dùng khi dev trên trình duyệt / test)
ZALO_MOCK=true

# Tài khoản quản trị mặc định tạo khi seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Mã thương hiệu (bắt buộc) – mỗi Mini App build cho 1 thương hiệu, gửi qua header X-Brand
VITE_BRAND=BRAND_A

# Địa chỉ backend API (không có dấu / ở cuối)
VITE_API_URL=http://localhost:4000

# true = đăng nhập giả lập (mockZaloId) để chạy trên trình duyệt thường.
# Backend cũng phải bật ZALO_MOCK=true. Khi chạy ngoài Zalo, app tự chuyển sang chế độ giả lập.
VITE_ZALO_MOCK=true

# (Tuỳ chọn) OA dự phòng nếu thương hiệu chưa khai báo zaloOaId trên trang quản trị
VITE_ZALO_OA_ID=

# (Tuỳ chọn) Ghi đè tiêu đề & màu header trong app-config.json khi build
VITE_APP_TITLE=
VITE_HEADER_COLOR=   # dạng "#B91C1C" (phải có dấu ngoặc kép)

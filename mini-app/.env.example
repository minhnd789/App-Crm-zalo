# Địa chỉ backend API (không có dấu / ở cuối)
VITE_API_URL=http://localhost:4000

# true = đăng nhập giả lập (mockZaloId) để chạy trên trình duyệt thường.
# Backend cũng phải bật ZALO_MOCK=true. Khi chạy ngoài Zalo, app tự chuyển sang chế độ giả lập.
VITE_ZALO_MOCK=true

# ID Official Account (OA) của nhà hàng – dùng cho nút "Quan tâm OA" và "Chat với nhà hàng"
VITE_ZALO_OA_ID=
